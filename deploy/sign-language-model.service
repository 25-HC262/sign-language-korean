[Unit]
Description=Sign Language Korean Model Server
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/sign-language-korean
ExecStart=/opt/sign-language-korean/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 메모리 집약적 모델을 위한 리소스 설정
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
